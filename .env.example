# Copy to .env in the repository root. Fill both passwords before starting.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lawground
POSTGRES_USER=lawground
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=lawground
RABBITMQ_PASSWORD=

# Spring (prod must be selected explicitly in the deployment environment)
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
LAWGROUND_DEV_AUTH_ENABLED=false
LAWGROUND_ANALYSIS_MOCK_ENABLED=false
# Retrieval worker is opt-in and mutually exclusive with Mock. No legal verifier yet.
LAWGROUND_ANALYSIS_LIVE_ENABLED=false
# Explicit comma-separated laws.id UUIDs; ALL selected date-specific chunks must be READY.
LAWGROUND_ANALYSIS_LIVE_LAW_IDS=
LAWGROUND_ANALYSIS_LIVE_CANDIDATE_LIMIT=5
LAWGROUND_ANALYSIS_LIVE_TOP_K=5
# Spring verifier core only. Enable after a real Python verifier advertises these exact pins.
LAWGROUND_VERIFICATION_ENABLED=false
AI_VERIFIER_MODEL_NAME=
AI_VERIFIER_MODEL_REVISION=
AI_VERIFIER_PROMPT_VERSION=
# Internal golden-set/evaluation services. No public management routes are added.
LAWGROUND_EVALUATION_ENABLED=false
LAWGROUND_EVALUATION_MANAGERS=
LAWGROUND_EVALUATION_MAX_CASES=20
# Exact deployed code commit for reproducible runs; curation does not require this value.
LAWGROUND_EVALUATION_BUILD_REVISION=

# Google OIDC: enabled requires ALL three values and DEV_AUTH_ENABLED=false.
LAWGROUND_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google

# Future law ingestion: not required for the bootstrap
LAW_GO_KR_API_KEY=

# Internal Python service. Use the SAME local secret in both services.
# Python app.main reads INTERNAL_API_TOKEN from its process environment.
AI_SERVICE_BASE_URL=http://127.0.0.1:8001/internal/v1
AI_SERVICE_API_KEY=
INTERNAL_API_TOKEN=
AI_EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
AI_TOKENIZER_VERSION=kiwipiepy-0.24.0+rules-1
AI_RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
